{
  "name": "verity-sample",
  "description": "Default matrix: the sample mod on the newest patch of every minor Minecraft version each loader supports.",
  "targets": [
    { "select": { "minecraft": ">=1.7.10", "loaders": ["vanilla", "fabric", "forge", "neoforge"], "latestPatchOnly": true } }
  ],
  "mods": [
    { "path": "build/libs/verity-testmod-*.jar" }
  ],
  "jvm": { "memoryMb": 2048, "args": ["-Dverity.sample.delay=15"] },
  "display": { "mode": "headless" },
  "test": { "startupTimeoutSec": 300, "timeoutSec": 360 }
}
