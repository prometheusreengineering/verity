{
  "name": "verity-sample-full",
  "description": "Scheduled matrix: the sample mod on the newest patch of every minor Minecraft version each loader supports.",
  "targets": [
    { "select": { "minecraft": ">=1.7.10", "loaders": ["forge"], "latestPatchOnly": true } },
    { "select": { "minecraft": ">=1.14", "loaders": ["fabric"], "latestPatchOnly": true } },
    { "select": { "minecraft": ">=1.20.2", "loaders": ["neoforge"], "latestPatchOnly": true } }
  ],
  "mods": [
    { "path": "build/libs/verity-testmod-*.jar" }
  ],
  "jvm": { "memoryMb": 2048, "args": ["-Dverity.sample.delay=15"] },
  "display": { "mode": "headless" },
  "test": { "startupTimeoutSec": 900, "timeoutSec": 1200 }
}
